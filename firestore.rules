rules_version = '2';
// zen·dom: only Sam's and Charlie's Google accounts can read or change anything.
// Paste this into Firebase console → Firestore → Rules, put in the two emails, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function isUs() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['SAM_EMAIL_HERE', 'CHARLIE_EMAIL_HERE'];
    }
    match /homes/zendom/records/{record} {
      allow read: if isUs();
      allow write: if isUs()
        && request.resource.data.keys().hasOnly(['del', 'j', 't', 'by', 'ts'])
        && request.resource.data.j is string
        && request.resource.data.j.size() < 900000;
    }
    // everything else stays closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
